{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numbi.local/schemas/import.schema.json",
  "title": "Numbi image import",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "order", "title", "category", "tags"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contentVersion": { "type": "integer", "minimum": 1, "default": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "order": { "type": "integer", "minimum": 1 },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "title": { "$ref": "#/$defs/localizedText" },
    "category": {
      "enum": ["animals", "nature", "food", "houses-cities", "space", "transport", "underwater", "fantasy", "landscapes", "cute-objects"]
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ru", "en"],
      "properties": {
        "ru": { "$ref": "#/$defs/tags" },
        "en": { "$ref": "#/$defs/tags" }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "columns": { "type": "integer", "minimum": 12, "maximum": 90 },
        "rows": { "type": "integer", "minimum": 12, "maximum": 90 },
        "colorCount": { "type": "integer", "minimum": 1, "maximum": 12 },
        "padding": { "type": "integer", "minimum": 0, "maximum": 6, "default": 1 },
        "removeWhiteBackground": { "type": "boolean", "default": true },
        "whiteThreshold": { "type": "integer", "minimum": 200, "maximum": 255, "default": 245 },
        "alphaThreshold": { "type": "integer", "minimum": 1, "maximum": 255, "default": 72 },
        "mergeColorDistance": { "type": "integer", "minimum": 0, "maximum": 100, "default": 28 }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ru", "en"],
      "properties": {
        "ru": { "type": "string", "minLength": 1, "maxLength": 80 },
        "en": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    }
  }
}
